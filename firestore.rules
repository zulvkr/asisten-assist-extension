rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Autentikasi diperlukan untuk semua akses koleksi
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Aturan spesifik untuk peran pengguna (bisa dibaca publik untuk dropdown login)
    match /user_roles/{email} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Aturan untuk sesi & data stock opname
    match /stock_opnames/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Aturan spesifik untuk rekomendasi belanja
    match /rekomendasi_belanja/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Aturan untuk tabel margin & pemetaan SKU
    match /margin_mappings/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Aturan untuk pengaturan sistem & Gemini API key
    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
