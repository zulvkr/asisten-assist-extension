{
  "name": "asisten-assist",
  "description": "Ekstensi asisten",
  "private": true,
  "version": "1.1.25",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bump": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-and-zip.ps1",
    "bump:minor": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-and-zip.ps1 minor",
    "bump:major": "powershell -ExecutionPolicy Bypass -File ./scripts/bump-and-zip.ps1 major",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7",
    "wxt": "^0.20.6"
  },
  "volta": {
    "node": "22.19.0"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.2",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "firebase": "^12.19.0",
    "pinia": "^3.0.4",
    "quasar": "^2.20.3",
    "vue": "^3.5.25",
    "xlsx": "^0.18.5"
  }
}
